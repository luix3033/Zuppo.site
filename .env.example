# Desenvolvimento local (sem segredos do frontend)
PORT=5173
ZUPPO_DATA_DIR=.local-data

# Provedor legado r2: configure ADMIN_EMAIL como segredo pelo Sites.
# No provedor supabase, a autorização usa Auth + admin_memberships.
# Os canais públicos são editados em Configurações no admin.

# Leitura do catálogo. Sem configuração mantém o armazenamento atual.
# Configure as mesmas variáveis no runtime da hospedagem, não em VITE_*.
CATALOG_PROVIDER=r2
SUPABASE_URL=https://seu-projeto.supabase.co
SUPABASE_PUBLISHABLE_KEY=
