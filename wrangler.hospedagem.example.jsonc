{
  "name": "zuppo-site",
  "main": "dist/server/index.js",
  "compatibility_date": "2026-10-29",
  "vars": {
    "CATALOG_PROVIDER": "supabase"
  },
  "r2_buckets": [
    {
      "binding": "BUCKET",
      "bucket_name": "SUBSTITUA-PELO-NOME-DO-BUCKET"
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": true,
    "binding": "ASSETS"
  },
  "keep_vars": true,
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "17001",
      "simple": {
        "limit": 30,
        "period": 60
      }
    },
    {
      "name": "EVENT_RATE_LIMITER",
      "namespace_id": "17002",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "CATALOG_RATE_LIMITER",
      "namespace_id": "17003",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "ADMIN_RATE_LIMITER",
      "namespace_id": "17004",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ]
}
