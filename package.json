{
  "name": "zuppo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env.local --import tsx server/dev.mjs",
    "build": "tsc -b && vite build && node scripts/build-pwa.mjs && node --import tsx scripts/build-worker.mjs",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --import tsx --test tests/*.test.ts",
    "deploy": "vercel deploy --prod",
    "check": "tsc -b",
    "build:vercel": "tsc -b && vite build && node scripts/build-pwa.mjs && node scripts/build-vercel.mjs",
    "deploy:cloudflare": "node scripts/deploy.mjs"
  },
  "dependencies": {
    "@vercel/blob": "^2.8.2",
    "@vercel/functions": "^3.10.5",
    "lucide-react": "^0.468.0",
    "motion": "^12.18.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.2"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.13",
    "@tailwindcss/vite": "^4.1.8",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.1.8",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "wrangler": "^4.156.0"
  },
  "engines": {
    "node": "24.x"
  }
}
